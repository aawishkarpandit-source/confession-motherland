# Public confessions — Vercel env vars
# Set these in Vercel Dashboard > confession-motherland > Settings > Environment Variables

SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role... (KEEP SECRET — server only, never prefix with VITE_)
ENCRYPTION_SECRET=base64-of-32-random-bytes (MUST match the access-panel project exactly)

